{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://hanuman.local/schemas/timeline.v2.json",
  "title": "HANUMAN Timeline Manifest v2",
  "description": "Design draft (Phase 4). Extends v1 with captions, broll, text overlays, music, sfx, transitions, and render settings. Not yet consumed by orchestrator or media worker.",
  "type": "object",
  "required": ["version", "metadata", "tracks"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "string", "const": "2" },
    "metadata": {
      "type": "object",
      "required": ["project_id", "run_id", "format_mode", "resolution", "fps", "duration_sec"],
      "additionalProperties": false,
      "properties": {
        "project_id": { "type": "string", "format": "uuid" },
        "run_id": { "type": "string", "format": "uuid" },
        "format_mode": { "type": "string", "enum": ["documentary", "listicle"] },
        "resolution": {
          "type": "object",
          "required": ["width", "height"],
          "additionalProperties": false,
          "properties": {
            "width": { "type": "integer", "const": 1920 },
            "height": { "type": "integer", "const": 1080 }
          }
        },
        "fps": { "type": "integer", "const": 30 },
        "duration_sec": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "captions_enabled": { "type": "boolean", "default": true },
        "show_transitions": { "type": "boolean", "default": true },
        "narration_volume": { "type": "number", "minimum": 0, "maximum": 1, "default": 1.0 },
        "music_volume": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.35 },
        "sfx_volume": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.5 },
        "clip_audio_volume": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.2 },
        "background_color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$", "default": "#000000" }
      }
    },
    "tracks": {
      "type": "object",
      "required": ["video", "audio", "captions", "broll", "text_overlays", "music", "sfx"],
      "additionalProperties": false,
      "properties": {
        "video": {
          "type": "array",
          "items": { "$ref": "#/definitions/videoClip" }
        },
        "audio": {
          "type": "array",
          "items": { "$ref": "#/definitions/audioClip" },
          "description": "Must include at least one narration clip."
        },
        "captions": {
          "type": "array",
          "items": { "$ref": "#/definitions/captionClip" }
        },
        "broll": {
          "type": "array",
          "items": { "$ref": "#/definitions/brollClip" }
        },
        "text_overlays": {
          "type": "array",
          "items": { "$ref": "#/definitions/textOverlayClip" }
        },
        "music": {
          "type": "array",
          "items": { "$ref": "#/definitions/musicClip" }
        },
        "sfx": {
          "type": "array",
          "items": { "$ref": "#/definitions/sfxClip" }
        }
      }
    },
    "transitions": {
      "type": "array",
      "items": { "$ref": "#/definitions/transition" },
      "description": "Transitions between consecutive video clips (after_clip_id references video[].id)."
    }
  },
  "definitions": {
    "videoClip": {
      "type": "object",
      "required": ["id", "scene_id", "type", "src", "start_sec", "duration_sec"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "scene_id": { "type": "string" },
        "type": { "type": "string", "enum": ["image", "video"] },
        "src": { "type": "string", "description": "S3 key or resolvable URI" },
        "start_sec": { "type": "number", "minimum": 0 },
        "duration_sec": { "type": "number", "exclusiveMinimum": 0 },
        "fit": { "type": "string", "enum": ["cover", "contain"], "default": "cover" },
        "hidden": { "type": "boolean", "default": false }
      }
    },
    "audioClip": {
      "type": "object",
      "required": ["id", "type", "src", "start_sec", "duration_sec"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string", "enum": ["narration"] },
        "src": { "type": "string" },
        "start_sec": { "type": "number", "minimum": 0 },
        "duration_sec": { "type": "number", "exclusiveMinimum": 0 },
        "volume": { "type": "number", "minimum": 0, "maximum": 1, "default": 1.0 },
        "hidden": { "type": "boolean", "default": false }
      }
    },
    "captionClip": {
      "type": "object",
      "required": ["id", "section_id", "text", "start_sec", "duration_sec"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "section_id": { "type": "string" },
        "text": { "type": "string" },
        "start_sec": { "type": "number", "minimum": 0 },
        "duration_sec": { "type": "number", "exclusiveMinimum": 0 },
        "style": { "$ref": "#/definitions/textStyle" },
        "hidden": { "type": "boolean", "default": false }
      }
    },
    "brollClip": {
      "type": "object",
      "required": ["id", "type", "src", "start_sec", "duration_sec"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "scene_id": { "type": "string", "description": "Optional link to scenes.json entry" },
        "type": { "type": "string", "enum": ["image", "video"] },
        "src": { "type": "string" },
        "start_sec": { "type": "number", "minimum": 0 },
        "duration_sec": { "type": "number", "exclusiveMinimum": 0 },
        "layer": {
          "type": "string",
          "enum": ["overlay", "replace"],
          "default": "overlay",
          "description": "overlay = PiP/full-bleed on top of base video; replace = covers base for interval"
        },
        "fit": { "type": "string", "enum": ["cover", "contain"], "default": "cover" },
        "position": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "x_pct": { "type": "number", "minimum": 0, "maximum": 100, "default": 50 },
            "y_pct": { "type": "number", "minimum": 0, "maximum": 100, "default": 50 },
            "width_pct": { "type": "number", "exclusiveMinimum": 0, "maximum": 100, "default": 100 }
          }
        },
        "hidden": { "type": "boolean", "default": false }
      }
    },
    "textOverlayClip": {
      "type": "object",
      "required": ["id", "text", "start_sec", "duration_sec", "position", "style"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "text": { "type": "string" },
        "start_sec": { "type": "number", "minimum": 0 },
        "duration_sec": { "type": "number", "exclusiveMinimum": 0 },
        "position": {
          "type": "object",
          "required": ["x_pct", "y_pct"],
          "additionalProperties": false,
          "properties": {
            "x_pct": { "type": "number", "minimum": 0, "maximum": 100 },
            "y_pct": { "type": "number", "minimum": 0, "maximum": 100 }
          }
        },
        "style": { "$ref": "#/definitions/textStyle" },
        "hidden": { "type": "boolean", "default": false }
      }
    },
    "musicClip": {
      "type": "object",
      "required": ["id", "src", "start_sec", "duration_sec"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "label": { "type": "string" },
        "src": { "type": "string" },
        "start_sec": { "type": "number", "minimum": 0 },
        "duration_sec": { "type": "number", "exclusiveMinimum": 0 },
        "volume": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.35 },
        "fade_in_sec": { "type": "number", "minimum": 0, "default": 0 },
        "fade_out_sec": { "type": "number", "minimum": 0, "default": 0 },
        "hidden": { "type": "boolean", "default": false }
      }
    },
    "sfxClip": {
      "type": "object",
      "required": ["id", "src", "start_sec", "duration_sec"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "label": { "type": "string" },
        "src": { "type": "string" },
        "start_sec": { "type": "number", "minimum": 0 },
        "duration_sec": { "type": "number", "exclusiveMinimum": 0 },
        "volume": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.6 },
        "hidden": { "type": "boolean", "default": false }
      }
    },
    "transition": {
      "type": "object",
      "required": ["id", "after_clip_id", "type", "duration_sec"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "after_clip_id": {
          "type": "string",
          "description": "video clip id; transition plays at end of this clip into the next"
        },
        "type": {
          "type": "string",
          "enum": ["cut", "fade", "slide", "zoom", "blur", "theme"],
          "description": "Phase 7: render fade+slide via xfade; others may map to fade until compositor exists"
        },
        "duration_sec": { "type": "number", "minimum": 0, "maximum": 2.0, "default": 0.4 },
        "enabled": { "type": "boolean", "default": true }
      }
    },
    "textStyle": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "preset": { "type": "string", "default": "default" },
        "font_size_px": { "type": "integer", "minimum": 8, "maximum": 120, "default": 18 },
        "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$", "default": "#FFFFFF" },
        "font_weight": { "type": "string", "enum": ["400", "500", "600", "700"], "default": "500" },
        "alignment": { "type": "string", "enum": ["left", "center", "right"], "default": "center" },
        "drop_shadow": { "type": "boolean", "default": true }
      }
    }
  }
}
