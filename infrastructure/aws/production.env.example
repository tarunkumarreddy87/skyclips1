# Native rendering; GPU workers require an NVIDIA-enabled host/container runtime.
RENDER_ENGINE=native
RENDER_SERVICE_URL=http://render-service.hanuman.local:8081
RENDER_ENCODER=auto
RENDER_MAX_CONCURRENT=1
AWS_REGION=us-east-1
S3_REGION=us-east-1
S3_BUCKET=your-artifact-bucket
S3_BUCKET_NAME=your-artifact-bucket
HANUMAN_STUB_MODE=false
NEXT_PUBLIC_PREVIEW_ENGINE=native

# Media CDN, optional.
MEDIA_CDN_BASE_URL=
NEXT_PUBLIC_MEDIA_CDN_BASE_URL=
SERPAPI_API_KEY=

# Dedicated OpenRouter key for scene image generation (independent of the text provider).
OPENROUTER_IMAGE_API_KEY=
