# SkyClip web — never commit real secrets. Copy to apps/web/.env.local

# App URL (Dodo return URLs + absolute links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Auth only (no Supabase business DB)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# MongoDB Atlas (subscriptions / entitlements — not auth sessions)
MONGODB_URI=mongodb+srv://USER:PASS@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=skyclip

# Dodo Payments (subscriptions)
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_PAYMENTS_RETURN_URL=http://localhost:3000/settings/billing
INTERNAL_API_KEY=dev-internal
DODO_CREDIT_ENTITLEMENT_ID=
DODO_PRODUCT_STARTER=
DODO_PRODUCT_CREATOR=
DODO_PRODUCT_PRO=
DODO_PRODUCT_SCALE=
DODO_PRODUCT_STUDIO=

# API proxy (browser uses /api → FastAPI)
NEXT_PUBLIC_API_URL=/api
# Server-side rewrite target (local FastAPI or ALB)
API_INTERNAL_URL=http://127.0.0.1:8000
# Optional media CDN (same value as API MEDIA_CDN_BASE_URL when enabled)
# NEXT_PUBLIC_MEDIA_CDN_BASE_URL=https://dxxxx.cloudfront.net

NEXT_PUBLIC_PREVIEW_ENGINE=native
