# Skyclip local development environment
# Copy this file to .env. These values are for local development only.
# Replace Supabase placeholders with a project you control to test real authentication.
# Never use development defaults in a public or production deployment.

# Required by the web Docker build. Placeholders do not provide working authentication.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY

# API Supabase settings. Stub mode below allows offline/local development.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=

# Local-only generation settings.
HANUMAN_STUB_MODE=true
PRODUCTION_AGENT_ENABLED=false
ALLOW_SILENT_TTS_FALLBACK=true
CORS_ORIGINS=http://localhost:3000

# Optional external AI/media providers.
OPENROUTER_API_KEY=
OPENROUTER_IMAGE_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
PEXELS_API_KEY=
SERPAPI_API_KEY=
SARVAM_API_KEY=
SARVAM_TTS_SPEAKER=shubh

# Render-service local API key. Replace with a unique random value on your machine.
RENDER_SERVICE_API_KEY=local-dev-change-this-key
RENDER_ENGINE=native
RENDER_FFMPEG_FALLBACK=false
RENDER_CACHE_MAX_BYTES=5368709120
RENDER_CACHE_TTL_SEC=604800
THREE_CAPTURE_MODE=auto
THREE_REQUIRE_GPU=0
THREE_ANGLE_BACKEND=

# MinIO is configured with local-only credentials in docker-compose.yml.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_PUBLIC_ENDPOINT=http://localhost:9000

# Frontend and local URL defaults.
NEXT_PUBLIC_PREVIEW_ENGINE=native
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
API_INTERNAL_URL=http://api:8000
